# Configurazione di PRODUZIONE (DB gestiti esterni, es. Azure).
# Copia in .env.prod e compila con i valori reali. NON committare i valori reali.
# Uso: docker compose --env-file .env.prod -f docker-compose.prod.yml up --build -d

# ============================================================
# MySQL - Azure Database for MySQL (Flexible Server)
# TLS obbligatorio -> sslMode=REQUIRED (per verificare il certificato: VERIFY_CA
# + truststore con la root DigiCert).
# ============================================================
MYSQL_URL=jdbc:mysql://<server>.mysql.database.azure.com:3306/<database>?sslMode=REQUIRED&serverTimezone=Europe/Rome&allowPublicKeyRetrieval=true
# Flexible Server: solo "utente".  Single Server (legacy): "utente@nomeserver".
MYSQL_USERNAME=<utente>
MYSQL_PASSWORD=<password>

# ============================================================
# MongoDB - stringa di connessione COMPLETA (contiene le credenziali).
# Esempi:
#  Cosmos DB API for Mongo (RU):
#    mongodb://<acc>:<key>@<acc>.mongo.cosmos.azure.com:10255/<db>?ssl=true&retrywrites=false&replicaSet=globaldb&maxIdleTimeMS=120000&appName=@<acc>@
#  Cosmos DB vCore / MongoDB Atlas:
#    mongodb+srv://<utente>:<password>@<host>/<db>?tls=true&authSource=admin
# ============================================================
MONGODB_URI=<connection-string-completa>

# ============================================================
# Routing / porte
# ============================================================
# URL interno del backend usato dal reverse-proxy nginx (SENZA slash finale).
# Sullo stesso compose lasciare il default; per un backend separato indicarne l'URL.
BACKEND_URL=http://backend:8081

# Porta pubblicata dal frontend sull'host (dietro l'ingress/HTTPS della piattaforma).
FRONTEND_PORT=8080
# Usata solo se si scommenta l'esposizione del backend in docker-compose.prod.yml.
BACKEND_PORT=8081
