# Variabili opzionali per docker-compose (tutte hanno un default sensato).
# Copia in .env e personalizza se necessario.

# Credenziali / nome database MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=facilita

# Nome database MongoDB
MONGO_DATABASE=facilita

# Porte pubblicate sull'host
FRONTEND_PORT=8080
BACKEND_PORT=8081
MYSQL_PORT=3306
MONGO_PORT=27017
